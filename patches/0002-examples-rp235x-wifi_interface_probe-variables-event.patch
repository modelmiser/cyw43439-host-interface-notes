+//! Exploring the CYW43439 firmware's host interface on a Pico 2 W, using the `diag` hooks in
+//! `cyw43` (see the patch this example comes with). It:
+//!
+//! 1. reads a few named variables and prints the firmware's status for each;
+//! 2. asks the firmware to send every event;
+//! 3. enables Wi-Fi Direct discovery and parks the radio on channel 6 with the listen state;
+//! 4. switches monitor mode on for 15 s and prints what arrived on the data channel;
+//! 5. switches everything off again and then prints an event census every 10 s.
+//!
+//! Monitor mode and scanning exclude each other, so nothing scans while monitor is on.
+//! Received frames identify other people's devices: mind what you log and keep.
+
+#![no_std]
+#![no_main]
+
+use cyw43::aligned_bytes;
+use cyw43_pio::{PioSpi, RM2_CLOCK_DIVIDER};
+use defmt::*;
+use defmt_rtt as _;
+use embassy_executor::Spawner;
+use embassy_rp::gpio::{Level, Output};
+use embassy_rp::peripherals::{DMA_CH0, DMA_CH1, PIO0};
+use embassy_rp::pio::{InterruptHandler, Pio};
+use embassy_rp::{bind_interrupts, dma};
+use embassy_time::Timer;
+use panic_probe as _;
+use static_cell::StaticCell;
+
+bind_interrupts!(struct Irqs {
+    PIO0_IRQ_0 => InterruptHandler<PIO0>;
+    DMA_IRQ_0 => dma::InterruptHandler<DMA_CH0>, dma::InterruptHandler<DMA_CH1>;
+});
+
+#[embassy_executor::task]
+async fn cyw43_task(
+    runner: cyw43::Runner<'static, cyw43::SpiBus<Output<'static>, PioSpi<'static, PIO0, 0>>, cyw43::Cyw43439>,
+) -> ! {
+    runner.run().await
+}
+
+/// Channel 6, 20 MHz, 2.4 GHz.
+const CHANSPEC_CH6: u16 = 0x1006;
+
+/// Value for `bsscfg:p2p_state`: config index, state (0 scan, 1 listen), pad, chanspec, dwell ms.
+fn p2p_state(idx: u32, state: u8, chanspec: u16, dwell_ms: u16) -> [u8; 10] {
+    let mut v = [0u8; 10];
+    v[..4].copy_from_slice(&idx.to_le_bytes());
+    v[4] = state;
+    v[6..8].copy_from_slice(&chanspec.to_le_bytes());
+    v[8..10].copy_from_slice(&dwell_ms.to_le_bytes());
+    v
+}
+
+fn print_events() {
+    let ev = cyw43::diag_events_take();
+    for (code, n) in ev.counts.iter().enumerate() {
+        if *n != 0 {
+            info!("event {}: {}", code, n);
+        }
+    }
+    for i in 0..ev.samples {
+        let n = (ev.present[i] as usize).min(cyw43::DIAG_HEAD);
+        info!(
+            "  sample: event {} datalen {} addr {=[u8]:02x} data {=[u8]:02x}",
+            ev.codes[i],
+            ev.lens[i],
+            ev.addrs[i],
+            ev.heads[i][..n]
+        );
+    }
+}
+
+#[embassy_executor::main(executor = "embassy_rp::executor::Executor", entry = "cortex_m_rt::entry")]
+async fn main(spawner: Spawner) {
+    let p = embassy_rp::init(Default::default());
+    let fw = aligned_bytes!("../../../../cyw43-firmware/43439A0.bin");
+    let clm = aligned_bytes!("../../../../cyw43-firmware/43439A0_clm.bin");
+    let nvram = aligned_bytes!("../../../../cyw43-firmware/nvram_rp2040.bin");
+
+    let pwr = Output::new(p.PIN_23, Level::Low);
+    let cs = Output::new(p.PIN_25, Level::High);
+    let mut pio = Pio::new(p.PIO0, Irqs);
+    let spi = PioSpi::new(
+        &mut pio.common,
+        pio.sm0,
+        RM2_CLOCK_DIVIDER,
+        pio.irq0,
+        cs,
+        p.PIN_24,
+        p.PIN_29,
+        dma::Channel::new(p.DMA_CH0, Irqs),
+        dma::Channel::new(p.DMA_CH1, Irqs),
+    );
+
+    static STATE: StaticCell<cyw43::State> = StaticCell::new();
+    let state = STATE.init(cyw43::State::new());
+    let (_net_device, mut control, runner) = cyw43::new(state, pwr, spi, fw, nvram).await;
+    spawner.spawn(unwrap!(cyw43_task(runner)));
+    control.init(clm, cyw43::Config::default()).await;
+
+    // 1. Named variables. Status 0 = accepted, -23 = unsupported (or unknown), -14 = the reply
+    //    needs a larger buffer. The reply is as long as the request, whatever the value's size.
+    for name in [
+        "zz_not_a_var",
+        "ver",
+        "chanspec",
+        "apsta",
+        "allmulti",
+        "event_msgs",
+        "cap",
+    ] {
+        let mut res = [0u8; 40];
+        let (status, len) = control.diag_get_iovar(name, &mut res).await;
+        info!(
+            "get {}: status {} len {} {=[u8]:02x}",
+            name,
+            status,
+            len,
+            res[..len.min(16)]
+        );
+    }
+
+    // 2. Every event, including the ones `init` switches off.
+    info!("enable all events: status {}", control.diag_enable_all_events().await);
+
+    // 3. Wi-Fi Direct discovery, then the listen state. The device address must differ from the
+    //    primary one: set the locally-administered bit.
+    let mut addr = control.address().await;
+    addr[0] |= 0x02;
+    let s0 = control.diag_set_iovar("p2p_disc", &0u32.to_le_bytes()).await;
+    let s1 = control.diag_set_iovar("p2p_da_override", &addr).await;
+    let s2 = control.diag_set_iovar("p2p_disc", &1u32.to_le_bytes()).await;
+    Timer::after_millis(500).await;
+    let mut res = [0u8; 16];
+    let (s3, _) = control.diag_get_iovar("p2p_dev", &mut res).await;
+    let idx = u32::from_le_bytes([res[0], res[1], res[2], res[3]]);
+    info!(
+        "p2p: disc0 {} da_override {} disc1 {} p2p_dev {} index {}",
+        s0, s1, s2, s3, idx
+    );
+    if s2 != 0 || s3 != 0 {
+        warn!("this firmware build did not accept Wi-Fi Direct discovery");
+    } else {
+        // 4. Monitor mode, aimed at channel 6 by three 5 s listen dwells.
+        let am = control.diag_set_allmulti(true).await;
+        let (ms, _) = control.diag_monitor(Some(1)).await;
+        info!("monitor on: allmulti {} set {}", am, ms);
+        let _ = cyw43::diag_rx_take();
+        for _ in 0..3 {
+            let s = control
+                .diag_set_iovar("bsscfg:p2p_state", &p2p_state(idx, 1, CHANSPEC_CH6, 5000))
+                .await;
+            if s != 0 {
+                warn!("listen state refused: {}", s);
+            }
+            Timer::after_millis(5200).await;
+        }
+        let rx = cyw43::diag_rx_take();
+        info!("monitor, 15 s on channel 6: {} frames, {} bytes", rx.frames, rx.bytes);
+        for (kind, n) in rx.kinds.iter().enumerate() {
+            if *n != 0 {
+                // kind = (frame-control byte 0 >> 2) & 0x3f: 0x20 beacon, 0x34 action, 0x10 probe request.
+                info!("  kind {:02x}: {}", kind, n);
+            }
+        }
+        for i in 0..rx.samples {
+            let n = (rx.lens[i] as usize).min(cyw43::DIAG_HEAD);
+            info!("  frame, {} bytes: {=[u8]:02x}", rx.lens[i], rx.heads[i][..n]);
+        }
+
+        // 5. Everything off again.
+        let (m0, _) = control.diag_monitor(Some(0)).await;
+        let am = control.diag_set_allmulti(false).await;
+        let s0 = control
+            .diag_set_iovar("bsscfg:p2p_state", &p2p_state(idx, 0, 0, 0))
+            .await;
+        let s1 = control.diag_set_iovar("p2p_disc", &0u32.to_le_bytes()).await;
+        info!("off: monitor {} allmulti {} state {} discovery {}", m0, am, s0, s1);
+    }
+
+    loop {
+        print_events();
+        Timer::after_secs(10).await;
+    }
+}
-- 
