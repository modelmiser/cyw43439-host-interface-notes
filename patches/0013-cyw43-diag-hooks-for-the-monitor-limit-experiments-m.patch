+
+// ---- Hooks for the monitor-limit experiments ----
+
+use core::cell::Cell;
+use core::sync::atomic::Ordering::Relaxed;
+use core::sync::atomic::AtomicBool;
+
+use aligned::{A4, Aligned};
+
+/// Data packets queued and sent. (A mutex, not atomic arithmetic: thumbv6m has no atomic add.)
+static DATA_TX: Mutex<CriticalSectionRawMutex, Cell<(u32, u32)>> = Mutex::new(Cell::new((0, 0)));
+
+/// Ask the runner to send `n` small broadcast data packets, one per pass of its loop, while it
+/// has send credit. There is no waker: the runner picks the request up when it next wakes, so keep
+/// the bus probe's timer on (`diag_bus_config` with a few ms) while using this.
+pub fn diag_send_data(n: u32) {
+    DATA_TX.lock(|c| {
+        let (queued, sent) = c.get();
+        c.set((queued.saturating_add(n), sent));
+    })
+}
+
+/// Data packets sent for `diag_send_data` since the previous call, and how many were still queued
+/// (the queue is cleared).
+pub fn diag_data_sent() -> (u32, u32) {
+    DATA_TX.lock(|c| {
+        let (queued, sent) = c.replace((0, 0));
+        (sent, queued)
+    })
+}
+
+pub(crate) fn take_data_tx() -> bool {
+    DATA_TX.lock(|c| {
+        let (queued, sent) = c.get();
+        if queued == 0 {
+            return false;
+        }
+        c.set((queued - 1, sent));
+        true
+    })
+}
+
+pub(crate) fn data_tx_sent() {
+    DATA_TX.lock(|c| {
+        let (queued, sent) = c.get();
+        c.set((queued, sent.wrapping_add(1)));
+    })
+}
+
+pub(crate) static IGNORE_CREDIT: AtomicBool = AtomicBool::new(false);
+
+/// With `on`, the runner sends even when the firmware's send limit says it may not.
+pub fn diag_ignore_credit(on: bool) {
+    IGNORE_CREDIT.store(on, Relaxed);
+}
+
+type Images = (&'static Aligned<A4, [u8]>, &'static Aligned<A4, [u8]>);
+static RESTART: Mutex<CriticalSectionRawMutex, Cell<Option<Images>>> = Mutex::new(Cell::new(None));
+/// Restarts completed, restarts failed, duration of the last in ms.
+static RESTARTS: Mutex<CriticalSectionRawMutex, Cell<(u32, u32, u32)>> = Mutex::new(Cell::new((0, 0, 0)));
+
+/// Ask the runner to power-cycle the radio and load the firmware again, in place (no Bluetooth).
+/// Any command in flight is abandoned. Afterwards the application must call `Control::init`
+/// again. Like `diag_send_data`, this is picked up when the runner next wakes.
+pub fn diag_request_restart(wifi_fw: &'static Aligned<A4, [u8]>, nvram: &'static Aligned<A4, [u8]>) {
+    RESTART.lock(|r| r.set(Some((wifi_fw, nvram))));
+}
+
+/// Restarts completed, restarts that failed, and how long the last one took in ms.
+pub fn diag_restart_result() -> (u32, u32, u32) {
+    RESTARTS.lock(|r| r.get())
+}
+
+pub(crate) fn take_restart() -> Option<Images> {
+    RESTART.lock(|r| r.take())
+}
+
+pub(crate) fn restart_done(ok: bool, millis: u32) {
+    RESTARTS.lock(|r| {
+        let (done, failed, _) = r.get();
+        r.set(if ok { (done + 1, failed, millis) } else { (done, failed + 1, millis) });
+    })
+}
+
+/// Bytes of firmware console text kept between `diag_console_take` calls.
+pub const DIAG_CONSOLE: usize = 4096;
+
+struct Console {
+    buf: [u8; DIAG_CONSOLE],
+    len: usize,
+    lost: u32,
+}
+
+static CONSOLE: Mutex<CriticalSectionRawMutex, RefCell<Console>> = Mutex::new(RefCell::new(Console {
+    buf: [0; DIAG_CONSOLE],
+    len: 0,
+    lost: 0,
+}));
+
+/// A line of the firmware's own console log, as the `firmware-logs` reader found it.
+#[allow(dead_code)]
+pub(crate) fn console_line(line: &[u8]) {
+    CONSOLE.lock(|c| {
+        let mut c = c.borrow_mut();
+        let at = c.len;
+        if at + line.len() + 1 > DIAG_CONSOLE {
+            c.lost += 1;
+            return;
+        }
+        c.buf[at..at + line.len()].copy_from_slice(line);
+        c.buf[at + line.len()] = b'\n';
+        c.len = at + line.len() + 1;
+    })
+}
+
+/// Take the firmware console text gathered since the previous call (lines separated by `\n`) into
+/// `out`; returns the bytes copied and how many lines were dropped for lack of room. Empty unless
+/// the `firmware-logs` feature is on.
+pub fn diag_console_take(out: &mut [u8]) -> (usize, u32) {
+    CONSOLE.lock(|c| {
+        let mut c = c.borrow_mut();
+        let n = c.len.min(out.len());
+        out[..n].copy_from_slice(&c.buf[..n]);
+        let lost = c.lost;
+        c.len = 0;
+        c.lost = 0;
+        (n, lost)
+    })
+}
