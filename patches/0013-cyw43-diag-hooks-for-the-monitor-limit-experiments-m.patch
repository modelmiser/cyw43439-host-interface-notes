     }
 
+    /// Diagnostic: power-cycle the radio and load the firmware again, in place.
+    async fn diag_restart(&mut self, wifi_fw: &Aligned<A4, [u8]>, nvram: &Aligned<A4, [u8]>) {
+        let started = Instant::now();
+        self.ioctl_state.abandon_ioctl();
+        self.ioctl_id = 0;
+        self.sdpcm_seq = 0;
+        self.sdpcm_seq_max = 1;
+        self.inline_ioctl_pending = false;
+        self.allmulti = false;
+        let ok = self.init(wifi_fw, nvram, None).await.is_ok();
+        crate::diag::restart_done(ok, started.elapsed().as_millis() as u32);
+    }
+
+    /// Diagnostic: send one 60-byte broadcast Ethernet frame (experimental ethertype 0x88b5) on
+    /// the data channel, the way a network packet is sent.
+    async fn diag_send_data(&mut self, buf: &mut Aligned<A4, [u8]>) {
+        const PADDING_SIZE: usize = 2;
+        const PACKET: usize = 60;
+        let write_buffer = WriteBuffer::new(buf);
+        let buf8 = write_buffer.buf();
+        let total_len = SdpcmHeader::SIZE + PADDING_SIZE + BdcHeader::SIZE + PACKET;
+        let seq = self.sdpcm_seq;
+        self.sdpcm_seq = self.sdpcm_seq.wrapping_add(1);
+        let sdpcm_header = SdpcmHeader {
+            len: total_len as u16,
+            len_inv: !total_len as u16,
+            sequence: seq,
+            channel_and_flags: CHANNEL_TYPE_DATA,
+            next_length: 0,
+            header_length: (SdpcmHeader::SIZE + PADDING_SIZE) as _,
+            wireless_flow_control: 0,
+            bus_data_credit: 0,
+            reserved: [0, 0],
+        };
+        let bdc_header = BdcHeader {
+            flags: BDC_VERSION << BDC_VERSION_SHIFT,
+            priority: 0,
+            flags2: 0,
+            data_offset: 0,
+        };
+        buf8[..total_len + 4].fill(0);
+        buf8[0..SdpcmHeader::SIZE].copy_from_slice(sdpcm_header.to_bytes());
+        buf8[SdpcmHeader::SIZE + PADDING_SIZE..][..BdcHeader::SIZE].copy_from_slice(bdc_header.to_bytes());
+        let packet = &mut buf8[SdpcmHeader::SIZE + PADDING_SIZE + BdcHeader::SIZE..][..PACKET];
+        packet[..6].fill(0xff);
+        packet[6..12].copy_from_slice(&crate::diag::DIAG_MARK);
+        packet[12] = 0x88;
+        packet[13] = 0xb5;
+        let total_len = (total_len + 3) & !3;
+        if self.wlan_write(&mut write_buffer[..total_len]).await.is_ok() {
+            crate::diag::data_tx_sent();
+        }
+        self.check_status(buf).await;
+    }
+
     /// Wait for IRQ on F2 packet available
     /// Diagnostic: sample the bus status and interrupt registers without being asked to by an
     /// interrupt or a command; optionally read a waiting packet. SPI only.
@@ -1445,6 +1524,9 @@ impl<'a, BUS: Bus, CHIP: Chip> Runner<'a, BUS, CHIP> {
     }
 
     fn has_credit(&self) -> bool {
+        if crate::diag::IGNORE_CREDIT.load(Relaxed) {
+            return true;
+        }
         self.sdpcm_seq != self.sdpcm_seq_max && self.sdpcm_seq_max.wrapping_sub(self.sdpcm_seq) & 0x80 == 0
     }
 
