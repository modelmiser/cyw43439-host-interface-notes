From: Chad Aldreda <ca@modelmiser.com>
Date: Fri, 20 Nov 2026 16:39:10 -0800
Subject: [PATCH 6/8] cyw43 diag: experiment knobs (F2 watermark, acknowledge
 all interrupt bits, poke) and a variants example

Used to test three host-side explanations for the monitor-mode stall on a
Pico 2 W (2026-11-21); none changed the result.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 cyw43/src/diag.rs                             |  15 ++
 cyw43/src/lib.rs                              |   2 +-
 cyw43/src/runner.rs                           |  18 +-
 .../rp235x/src/bin/wifi_monitor_variants.rs   | 161 ++++++++++++++++++
 4 files changed, 193 insertions(+), 3 deletions(-)
 create mode 100644 examples/rp235x/src/bin/wifi_monitor_variants.rs

diff --git a/cyw43/src/diag.rs b/cyw43/src/diag.rs
index caa53ab72..87e78dca6 100644
--- a/cyw43/src/diag.rs
+++ b/cyw43/src/diag.rs
@@ -322,3 +322,18 @@ pub fn diag_bus_config(sample_ms: u32, drain: bool) {
     DRAIN.store(drain, core::sync::atomic::Ordering::Relaxed);
     SAMPLE_MS.store(sample_ms, core::sync::atomic::Ordering::Relaxed);
 }
+
+/// Experiment knobs (driver variants for the monitor-mode stall). 0 = the driver's own watermark.
+pub(crate) static X_WATERMARK: core::sync::atomic::AtomicU8 = core::sync::atomic::AtomicU8::new(0);
+/// Acknowledge every interrupt-register bit read, as the C driver and whd do.
+pub(crate) static X_ACK_ALL: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+/// On each bus sample, write the SDIO-style "poke" to the bus core's mailbox register.
+pub(crate) static X_POKE: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+/// Select driver variants for an experiment. Call before `cyw43::new` (the watermark is written
+/// during bring-up). `watermark` 0 keeps the driver's value.
+pub fn diag_experiment(watermark: u8, ack_all: bool, poke: bool) {
+    X_WATERMARK.store(watermark, core::sync::atomic::Ordering::Relaxed);
+    X_ACK_ALL.store(ack_all, core::sync::atomic::Ordering::Relaxed);
+    X_POKE.store(poke, core::sync::atomic::Ordering::Relaxed);
+}
