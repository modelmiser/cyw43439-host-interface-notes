+    "rrm",
+    "rrm_bcn_req",
+    "rrm_bcn_req_max_off_chan_time",
+    "rrm_bcn_req_thrtl_win",
+    "rrm_bcn_req_traff_meas_per",
+    "rrm_chload_req",
+    "rrm_frame_req",
+    "rrm_lm_req",
+    "rrm_nbr_list",
+    "rrm_nbr_req",
+    "rrm_noise_req",
+    "rrm_stat_req",
+    "sae_max_pwe_loop",
+    "sae_transition_mode",
+    "scan_assoc_time",
+    "scan_home_time",
+    "scan_nprobes",
+    "scan_passive_time",
+    "scan_unassoc_time",
+    "scanmac",
+    "sgi_rx",
+    "sgi_tx",
+    "ssid",
+    "sup_wpa",
+    "sup_wpa2_eapver",
+    "sup_wpa_tmo",
+    "swdiv_timeout",
+    "tlv",
+    "twt",
+    "ulp",
+    "ulp_host_intr_mode",
+    "ulp_wait",
+    "ver",
+    "vht_features",
+    "vndr_ie",
+    "wd_disable",
+    "wme_ac_sta",
+    "wnm",
+    "wnm_bsstrans_query",
+    "wnm_bsstrans_resp",
+    "wpa_auth",
+    "wsec",
+    "wsec_info",
+];
+const VAR: usize = 1040;
+const BATCH: usize = 10;
+/// Channel 11, 20 MHz, 2.4 GHz.
+const CH11: u16 = 0x100b;
+
+/// Print the firmware console text gathered since the last call.
+fn console(tag: &str) {
+    static mut TEXT: [u8; cyw43::DIAG_CONSOLE] = [0; cyw43::DIAG_CONSOLE];
+    // SAFETY: single task, used sequentially.
+    #[allow(static_mut_refs)]
+    let text = unsafe { &mut TEXT };
+    let (n, lost) = cyw43::diag_console_take(&mut text[..]);
+    let mut lines = 0u32;
+    for raw in text[..n].split(|c| *c == b'\n') {
+        if raw.is_empty() {
+            continue;
+        }
+        lines += 1;
+        info!("console {}: {=[u8]:a}", tag, raw[..raw.len().min(200)]);
+    }
+    info!("console {}: {} lines, {} dropped", tag, lines, lost);
+}
+
+#[embassy_executor::main(executor = "embassy_rp::executor::Executor", entry = "cortex_m_rt::entry")]
+async fn main(spawner: Spawner) {
+    let p = embassy_rp::init(Default::default());
+    let fw = aligned_bytes!("../../../../cyw43-firmware/43439A0.bin");
+    let clm = aligned_bytes!("../../../../cyw43-firmware/43439A0_clm.bin");
+    let nvram = aligned_bytes!("../../../../cyw43-firmware/nvram_rp2040.bin");
+
+    let pwr = Output::new(p.PIN_23, Level::Low);
+    let cs = Output::new(p.PIN_25, Level::High);
+    let mut pio = Pio::new(p.PIO0, Irqs);
+    let spi = PioSpi::new(
+        &mut pio.common,
+        pio.sm0,
+        RM2_CLOCK_DIVIDER,
+        pio.irq0,
+        cs,
+        p.PIN_24,
+        p.PIN_29,
+        dma::Channel::new(p.DMA_CH0, Irqs),
+        dma::Channel::new(p.DMA_CH1, Irqs),
+    );
+
+    static STATE: StaticCell<cyw43::State> = StaticCell::new();
+    let state = STATE.init(cyw43::State::new());
+    let (_net_device, mut control, runner) = cyw43::new(state, pwr, spi, fw, nvram).await;
+    spawner.spawn(unwrap!(cyw43_task(runner)));
+    control.init(clm, cyw43::Config::default()).await;
+
+    cyw43::diag_bus_config(20, false);
+    Timer::after_secs(2).await;
+    static mut A: [[u8; VAR]; BATCH] = [[0; VAR]; BATCH];
+    static mut B: [[u8; VAR]; BATCH] = [[0; VAR]; BATCH];
+    // SAFETY: single task, used sequentially.
+    #[allow(static_mut_refs)]
+    let (a, b) = unsafe { (&mut A, &mut B) };
+    let mut answered = [false; NAMES.len()];
+    let mut changed = [false; NAMES.len()];
+    console("boot");
+    for (i, name) in NAMES.iter().enumerate() {
+        let (status, len) = control.diag_get_iovar_buf(name, &mut a[0][..]).await;
+        answered[i] = status == 0;
+        info!("probe {} status {} len {} head {=[u8]:02x}", name, status, len, a[0][..len.min(24)]);
+        // Often, so the console capture does not fill: a rejected name costs two console lines.
+        if i % 16 == 15 {
+            console("probe");
+        }
+    }
+    console("after-probe");
+    for pass in 0..2 {
+        let monitor = pass == 0;
+        let tag = if monitor { "monitor" } else { "control" };
+        let mut next = 0usize;
+        loop {
+            let mut batch = [0usize; BATCH];
+            let mut count = 0;
+            while next < NAMES.len() && count < BATCH {
+                if (monitor && answered[next]) || (!monitor && changed[next]) {
+                    batch[count] = next;
+                    count += 1;
+                }
+                next += 1;
+            }
+            if count == 0 {
+                break;
+            }
+            if !park(&mut control, CH11).await {
+                return;
+            }
+            Timer::after_millis(300).await;
+            let mut lens = [0usize; BATCH];
+            for k in 0..count {
+                let (_, len) = control.diag_get_iovar_buf(NAMES[batch[k]], &mut a[k][..]).await;
+                lens[k] = len.min(VAR);
+            }
+            let _ = cyw43::diag_rx_take();
+            let mut ms = -1;
+            if monitor {
+                ms = control.diag_monitor(Some(1)).await.0;
+            }
+            Timer::after_millis(1000).await;
+            let rx = cyw43::diag_rx_take();
+            let mut statuses = [0i32; BATCH];
+            for k in 0..count {
+                let (status, _) = control.diag_get_iovar_buf(NAMES[batch[k]], &mut b[k][..]).await;
+                statuses[k] = status;
+            }
+            info!("session {}: monitor status {} burst frames {} names:", tag, ms, rx.frames);
+            for k in 0..count {
+                let name = NAMES[batch[k]];
+                let n = lens[k] & !3;
+                let mut diffs = 0u32;
+                for w in (0..n).step_by(4) {
+                    let x = u32::from_le_bytes([a[k][w], a[k][w + 1], a[k][w + 2], a[k][w + 3]]);
+                    let y = u32::from_le_bytes([b[k][w], b[k][w + 1], b[k][w + 2], b[k][w + 3]]);
+                    if x != y {
+                        diffs += 1;
+                        if diffs <= 40 {
+                            info!("  {} {} word at {}: {:x} -> {:x}", tag, name, w, x, y);
+                        }
+                    }
+                }
+                info!("  {} {}: status after {} len {} words changed {}", tag, name, statuses[k], lens[k], diffs);
+                if monitor && (diffs > 0 || statuses[k] != 0) {
+                    changed[batch[k]] = true;
+                }
+            }
+            console(tag);
+            if !restart(&mut control, fw, nvram, clm).await {
+                return;
+            }
+        }
+    }
+    info!("done");
+    loop {
+        Timer::after_secs(60).await;
+    }
+}
