+    "mesh_max_peers",
+    "mesh_peer",
+    "mesh_peer_status",
+    "mfp",
+    "mimo_bw_cap",
+    "mpc",
+    "ndoe",
+    "nmode",
+    "nphy_antsel",
+    "nrate",
+    "oce",
+    "offload_config",
+    "p2p_dev",
+    "p2p_disc",
+    "p2p_if",
+    "p2p_ip_addr",
+    "p2p_ssid",
+    "p2p_state",
+    "phyrate_dump",
+    "phyrate_log",
+    "phyrate_log_size",
+    "pkt_filter_enable",
+    "pkt_filter_list",
+    "pkt_filter_mode",
+    "pkt_filter_stats",
+    "pm2_sleep_ret",
+    "pm_limit",
+    "pspretend_retry_limit",
+    "pspretend_threshold",
+    "qtxpower",
+    "rmc_ackreq",
