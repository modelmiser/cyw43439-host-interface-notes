diff --git a/cyw43/src/diag.rs b/cyw43/src/diag.rs
new file mode 100644
index 000000000..ab7d0bb7c
--- /dev/null
+++ b/cyw43/src/diag.rs
@@ -0,0 +1,166 @@
+//! Diagnostics for exploring the firmware's host interface: the status of the last command
+//! reply, counts and first bytes of frames received on the data channel, and a census of every
+//! event the firmware sends (before the driver's own filtering). Not meant for production use.
+
+use core::cell::RefCell;
+use core::sync::atomic::AtomicI32;
+
+use embassy_sync::blocking_mutex::Mutex;
+use embassy_sync::blocking_mutex::raw::CriticalSectionRawMutex;
+
+/// Bytes kept from the start of each sampled frame.
+pub const DIAG_HEAD: usize = 64;
+/// Frames sampled per `diag_rx_take` interval (the first ones to arrive).
+pub const DIAG_SAMPLES: usize = 8;
+
+pub(crate) static LAST_IOCTL_STATUS: AtomicI32 = AtomicI32::new(0);
+
+/// What arrived on the data channel since the previous `diag_rx_take`.
+#[derive(Clone, Copy)]
+pub struct DiagRx {
+    /// Frames received.
+    pub frames: u32,
+    /// Their total length.
+    pub bytes: u32,
+    /// Frames by `(first byte >> 2) & 0x3f`: the 802.11 type and subtype if the frame starts
+    /// with an 802.11 frame-control field.
+    pub kinds: [u32; 64],
+    /// How many of `heads` are filled.
+    pub samples: usize,
+    /// Full length of each sampled frame.
+    pub lens: [u16; DIAG_SAMPLES],
+    /// The first `DIAG_HEAD` bytes of each sampled frame.
+    pub heads: [[u8; DIAG_HEAD]; DIAG_SAMPLES],
+}
+
+impl DiagRx {
+    const fn new() -> Self {
+        Self {
+            frames: 0,
+            bytes: 0,
+            kinds: [0; 64],
+            samples: 0,
+            lens: [0; DIAG_SAMPLES],
+            heads: [[0; DIAG_HEAD]; DIAG_SAMPLES],
+        }
+    }
+}
+
+static RX: Mutex<CriticalSectionRawMutex, RefCell<DiagRx>> = Mutex::new(RefCell::new(DiagRx::new()));
+
+pub(crate) fn rx_frame(packet: &[u8]) {
+    RX.lock(|rx| {
+        let mut rx = rx.borrow_mut();
+        rx.frames = rx.frames.wrapping_add(1);
+        rx.bytes = rx.bytes.wrapping_add(packet.len() as u32);
+        if let Some(&b) = packet.first() {
+            rx.kinds[((b >> 2) & 0x3f) as usize] += 1;
+        }
+        let i = rx.samples;
+        // At most two beacons among the samples, so other frame kinds are not crowded out.
+        let beacon = packet.first() == Some(&0x80);
+        let beacons = rx.heads[..i].iter().filter(|h| h[0] == 0x80).count();
+        if i < DIAG_SAMPLES && !(beacon && beacons >= 2) {
+            let n = packet.len().min(DIAG_HEAD);
+            rx.heads[i][..n].copy_from_slice(&packet[..n]);
+            rx.lens[i] = packet.len() as u16;
+            rx.samples = i + 1;
+        }
+    });
+}
+
+/// Take and reset the data-channel counters and samples.
+pub fn diag_rx_take() -> DiagRx {
+    RX.lock(|rx| rx.replace(DiagRx::new()))
+}
+
+/// Event samples kept per `diag_events_take` interval.
+pub const DIAG_EV_SAMPLES: usize = 16;
+/// Event codes whose data is sampled, at most two each per interval: the management-frame
+/// events, plus IF (54), P2P_DISC_LISTEN_COMPLETE (55) and ACTION_FRAME (59).
+pub const DIAG_EV_SAMPLED: [u8; 8] = [44, 54, 55, 59, 71, 72, 75, 137];
+
+/// Every event the firmware sent since the previous `diag_events_take`, subscribed or not.
+#[derive(Clone, Copy)]
+pub struct DiagEvents {
+    /// Events by code (low 8 bits of the event type).
+    pub counts: [u32; 256],
+    /// How many samples are filled.
+    pub samples: usize,
+    /// Event code of each sample.
+    pub codes: [u8; DIAG_EV_SAMPLES],
+    /// The event message's `datalen` for each sample.
+    pub lens: [u32; DIAG_EV_SAMPLES],
+    /// The event message's `addr` for each sample.
+    pub addrs: [[u8; 6]; DIAG_EV_SAMPLES],
+    /// The first `DIAG_HEAD` bytes of each sample's event data.
+    pub heads: [[u8; DIAG_HEAD]; DIAG_EV_SAMPLES],
+    /// Bytes of event data actually present for each sample (at most `DIAG_HEAD` are kept).
+    pub present: [u16; DIAG_EV_SAMPLES],
+    /// ACTION_FRAME_RX (75) events: `mactime` of the first and the last one in the interval.
+    pub af_first: u32,
+    /// See `af_first`.
+    pub af_last: u32,
+    /// ACTION_FRAME_RX (75) events: lowest and highest `rssi` in the interval.
+    pub af_rssi_min: i32,
+    /// See `af_rssi_min`.
+    pub af_rssi_max: i32,
+}
+
+impl DiagEvents {
+    const fn new() -> Self {
+        Self {
+            counts: [0; 256],
+            samples: 0,
+            codes: [0; DIAG_EV_SAMPLES],
+            lens: [0; DIAG_EV_SAMPLES],
+            addrs: [[0; 6]; DIAG_EV_SAMPLES],
+            heads: [[0; DIAG_HEAD]; DIAG_EV_SAMPLES],
+            present: [0; DIAG_EV_SAMPLES],
+            af_first: 0,
+            af_last: 0,
+            af_rssi_min: 0,
+            af_rssi_max: 0,
+        }
+    }
+}
+
+static EV: Mutex<CriticalSectionRawMutex, RefCell<DiagEvents>> = Mutex::new(RefCell::new(DiagEvents::new()));
+
+pub(crate) fn event(code: u8, datalen: u32, addr: [u8; 6], data: &[u8]) {
+    EV.lock(|ev| {
+        let mut ev = ev.borrow_mut();
+        ev.counts[code as usize] = ev.counts[code as usize].wrapping_add(1);
+        if code == 75 && data.len() >= 16 {
+            let rssi = i32::from_be_bytes([data[4], data[5], data[6], data[7]]);
+            let mactime = u32::from_be_bytes([data[8], data[9], data[10], data[11]]);
+            if ev.counts[75] == 1 {
+                ev.af_first = mactime;
+                ev.af_rssi_min = rssi;
+                ev.af_rssi_max = rssi;
+            }
+            ev.af_last = mactime;
+            ev.af_rssi_min = ev.af_rssi_min.min(rssi);
+            ev.af_rssi_max = ev.af_rssi_max.max(rssi);
+        }
+        if !DIAG_EV_SAMPLED.contains(&code) {
+            return;
+        }
+        let i = ev.samples;
+        let same = ev.codes[..i].iter().filter(|c| **c == code).count();
+        if i < DIAG_EV_SAMPLES && same < 2 {
+            let n = data.len().min(DIAG_HEAD);
+            ev.heads[i][..n].copy_from_slice(&data[..n]);
+            ev.present[i] = data.len() as u16;
+            ev.codes[i] = code;
+            ev.lens[i] = datalen;
+            ev.addrs[i] = addr;
+            ev.samples = i + 1;
+        }
+    });
+}
+
+/// Take and reset the event census.
+pub fn diag_events_take() -> DiagEvents {
+    EV.lock(|ev| ev.replace(DiagEvents::new()))
+}
