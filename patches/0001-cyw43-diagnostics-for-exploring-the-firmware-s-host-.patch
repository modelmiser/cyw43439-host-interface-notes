+    pub async fn diag_monitor(&mut self, set: Option<u32>) -> (i32, u32) {
+        let mut buf = set.unwrap_or(0).to_le_bytes();
+        match set {
+            Some(_) => self.ioctl(IoctlType::Set, Ioctl::SetMonitor, 0, &mut buf).await,
