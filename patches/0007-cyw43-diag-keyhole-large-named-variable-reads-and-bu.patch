diff --git a/cyw43/src/control.rs b/cyw43/src/control.rs
index 344a2eb9c..970eb428e 100644
--- a/cyw43/src/control.rs
+++ b/cyw43/src/control.rs
@@ -769,6 +769,20 @@ impl<'a> Control<'a> {
         crate::diag::LAST_IOCTL_STATUS.load(core::sync::atomic::Ordering::Relaxed)
     }
 
+    /// Diagnostic: read a named variable into a caller-sized buffer (for replies longer than 64
+    /// bytes). `buf` must hold the name, a NUL, and the reply. Returns the firmware's status and
+    /// the reply length; the reply starts at `buf[0]`.
+    pub async fn diag_get_iovar_buf(&mut self, name: &str, buf: &mut [u8]) -> (i32, usize) {
+        crate::diag::LAST_IOCTL_STATUS.store(crate::diag::DIAG_NO_REPLY, core::sync::atomic::Ordering::Relaxed);
+        buf.fill(0);
+        buf[..name.len()].copy_from_slice(name.as_bytes());
+        let len = self.ioctl_inner(IoctlType::Get, Ioctl::GetVar, 0, buf).await;
+        (
+            crate::diag::LAST_IOCTL_STATUS.load(core::sync::atomic::Ordering::Relaxed),
+            len,
+        )
+    }
+
     /// Diagnostic: write a named variable (name + value at most 195 bytes). Returns the firmware's
     /// status. For a `bsscfg:` name the caller puts the 4-byte index first in `val`.
     pub async fn diag_set_iovar(&mut self, name: &str, val: &[u8]) -> i32 {
diff --git a/cyw43/src/diag.rs b/cyw43/src/diag.rs
index 87e78dca6..cb9fabbce 100644
--- a/cyw43/src/diag.rs
+++ b/cyw43/src/diag.rs
@@ -220,6 +220,11 @@ pub struct DiagBus {
     pub credit_max: u8,
     /// Headers that carried credit.
     pub credit_seen: u32,
+    /// Bus-core registers at the last sample, when the keyhole is on: intstatus (0x20),
+    /// hostintmask (0x24), tosbmailboxdata (0x48), tohostmailboxdata (0x4C), then the twelve
+    /// counters at 0x110..=0x13C (cmd52rd, cmd52wr, cmd53rd, cmd53wr, abort, datacrcerror,
+    /// rdoutofsync, wroutofsync, writebusy, readwait, readterm, writeterm), as linux names them.
+    pub core: [u32; 16],
 }
 
 impl DiagBus {
@@ -242,6 +247,7 @@ impl DiagBus {
             credit_min: 0,
             credit_max: 0,
             credit_seen: 0,
+            core: [0; 16],
         }
     }
 }
@@ -337,3 +343,20 @@ pub fn diag_experiment(watermark: u8, ack_all: bool, poke: bool) {
     X_ACK_ALL.store(ack_all, core::sync::atomic::Ordering::Relaxed);
     X_POKE.store(poke, core::sync::atomic::Ordering::Relaxed);
 }
+
+/// Whether the bus probe also reads the bus core's registers on each sample.
+pub(crate) static X_CORE: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+/// Offsets, from the bus core's base, of the registers the keyhole reads.
+pub(crate) const CORE_REGS: [u32; 16] = [
+    0x20, 0x24, 0x48, 0x4C, 0x110, 0x114, 0x118, 0x11C, 0x120, 0x124, 0x128, 0x12C, 0x130, 0x134, 0x138, 0x13C,
+];
+
+pub(crate) fn bus_core(vals: [u32; 16]) {
+    BUS.lock(|b| b.borrow_mut().core = vals);
+}
+
+/// Switch the bus-core keyhole on or off (it adds sixteen backplane reads to each bus sample).
+pub fn diag_keyhole(on: bool) {
+    X_CORE.store(on, core::sync::atomic::Ordering::Relaxed);
+}
