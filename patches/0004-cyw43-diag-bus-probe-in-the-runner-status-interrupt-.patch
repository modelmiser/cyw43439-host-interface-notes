     /// Wait for IRQ on F2 packet available
+    /// Diagnostic: sample the bus status and interrupt registers without being asked to by an
+    /// interrupt or a command; optionally read a waiting packet. SPI only.
+    async fn diag_sample(&mut self, buf: &mut Aligned<A4, [u8]>) {
+        self.diag_last = Instant::now();
+        if !matches!(BUS::TYPE, BusType::Spi) {
+            return;
+        }
+        let status = self.bus.read32(FUNC_BUS, SPI_STATUS_REGISTER).await;
+        let irq = self.bus.read16(FUNC_BUS, REG_BUS_INTERRUPT).await;
+        crate::diag::bus_sample(status, irq, self.sdpcm_seq, self.sdpcm_seq_max, self.has_credit());
+        if crate::diag::DRAIN.load(Relaxed) && status & STATUS_F2_PKT_AVAILABLE != 0 {
+            self.check_status(buf).await;
+        }
+    }
+
     async fn handle_irq(&mut self, buf: &mut Aligned<A4, [u8]>) {
         match BUS::TYPE {
             BusType::Sdio => {
@@ -1014,7 +1043,13 @@ impl<'a, BUS: Bus, CHIP: Chip> Runner<'a, BUS, CHIP> {
             }
             BusType::Spi => {
                 // Receive stuff
+                // Diagnostic: rate-limited status sample even when interrupts keep the loop busy.
+                let diag_ms = crate::diag::SAMPLE_MS.load(Relaxed);
+                if diag_ms != 0 && self.diag_last.elapsed() >= Duration::from_millis(diag_ms as u64) {
+                    self.diag_sample(buf).await;
+                }
                 let irq = self.bus.read16(FUNC_BUS, REG_BUS_INTERRUPT).await;
+                crate::diag::bus_irq(irq);
                 if irq != 0 {
                     trace!("irq{}", FormatInterrupt(irq));
                 }
@@ -1151,9 +1186,11 @@ impl<'a, BUS: Bus, CHIP: Chip> Runner<'a, BUS, CHIP> {
     fn rx(&mut self, buf: &mut [u8]) -> Option<Reception> {
