 3 files changed, 189 insertions(+), 5 deletions(-)

diff --git a/cyw43/src/diag.rs b/cyw43/src/diag.rs
index 3e6879950..caa53ab72 100644
--- a/cyw43/src/diag.rs
+++ b/cyw43/src/diag.rs
@@ -176,3 +176,149 @@ pub(crate) fn event(code: u8, datalen: u32, addr: [u8; 6], data: &[u8]) {
 pub fn diag_events_take() -> DiagEvents {
     EV.lock(|ev| ev.replace(DiagEvents::new()))
 }
+
+/// Sampling period of the bus probe in the runner, in ms; 0 = off.
+pub(crate) static SAMPLE_MS: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+/// Whether a sample that finds a packet waiting also reads it.
+pub(crate) static DRAIN: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+/// What the runner saw on the bus since the previous `diag_bus_take` (SPI bus only).
+#[derive(Clone, Copy)]
+pub struct DiagBus {
+    /// Status/interrupt register samples taken.
+    pub samples: u32,
+    /// Samples whose status register had "F2 packet available" set.
+    pub avail: u32,
+    /// Samples whose interrupt register had "F2 packet available" set.
+    pub irq_avail: u32,
+    /// Samples taken while the runner had no credit to send.
+    pub no_credit: u32,
+    /// Status register at the last sample.
+    pub last_status: u32,
+    /// Interrupt register at the last sample.
+    pub last_irq: u16,
+    /// OR of every interrupt register value seen.
+    pub irq_or: u16,
+    /// Times the interrupt handler ran.
+    pub irqs: u32,
+    /// Packets read from the bus.
+    pub pkts: u32,
+    /// Packets read whose SDPCM header did not parse (these update neither credit nor counters).
+    pub parse_fail: u32,
+    /// Times the runner found it had no credit to send.
+    pub tx_stalled: u32,
+    /// The runner's send sequence number and the limit it derived, at the last sample or stall.
+    pub seq: u8,
+    /// See `seq`.
+    pub seq_max: u8,
+    /// Raw `bus_data_credit` byte of the last header on a credit-carrying channel, and the
+    /// lowest and highest seen in the interval (`credit_seen` = 0 means none arrived).
+    pub credit_last: u8,
+    /// See `credit_last`.
+    pub credit_min: u8,
+    /// See `credit_last`.
+    pub credit_max: u8,
+    /// Headers that carried credit.
+    pub credit_seen: u32,
+}
+
+impl DiagBus {
+    const fn new() -> Self {
+        Self {
+            samples: 0,
+            avail: 0,
+            irq_avail: 0,
+            no_credit: 0,
+            last_status: 0,
+            last_irq: 0,
+            irq_or: 0,
+            irqs: 0,
+            pkts: 0,
+            parse_fail: 0,
+            tx_stalled: 0,
+            seq: 0,
+            seq_max: 0,
+            credit_last: 0,
+            credit_min: 0,
+            credit_max: 0,
+            credit_seen: 0,
+        }
+    }
+}
+
+static BUS: Mutex<CriticalSectionRawMutex, RefCell<DiagBus>> = Mutex::new(RefCell::new(DiagBus::new()));
+
+pub(crate) fn bus_sample(status: u32, irq: u16, seq: u8, seq_max: u8, has_credit: bool) {
+    BUS.lock(|b| {
+        let mut b = b.borrow_mut();
+        b.samples = b.samples.wrapping_add(1);
+        if status & 0x100 != 0 {
+            b.avail = b.avail.wrapping_add(1);
+        }
+        if irq & 0x20 != 0 {
+            b.irq_avail = b.irq_avail.wrapping_add(1);
+        }
+        if !has_credit {
+            b.no_credit = b.no_credit.wrapping_add(1);
+        }
+        b.last_status = status;
+        b.last_irq = irq;
+        b.irq_or |= irq;
+        b.seq = seq;
+        b.seq_max = seq_max;
+    });
+}
+
+pub(crate) fn bus_irq(irq: u16) {
+    BUS.lock(|b| {
+        let mut b = b.borrow_mut();
+        b.irqs = b.irqs.wrapping_add(1);
+        b.irq_or |= irq;
+    });
+}
+
+pub(crate) fn bus_pkt(parsed: bool) {
+    BUS.lock(|b| {
+        let mut b = b.borrow_mut();
+        b.pkts = b.pkts.wrapping_add(1);
+        if !parsed {
+            b.parse_fail = b.parse_fail.wrapping_add(1);
+        }
+    });
+}
+
+pub(crate) fn bus_credit(raw: u8) {
+    BUS.lock(|b| {
+        let mut b = b.borrow_mut();
+        if b.credit_seen == 0 {
+            b.credit_min = raw;
+            b.credit_max = raw;
+        }
+        b.credit_min = b.credit_min.min(raw);
+        b.credit_max = b.credit_max.max(raw);
+        b.credit_last = raw;
+        b.credit_seen = b.credit_seen.wrapping_add(1);
+    });
+}
+
+pub(crate) fn bus_tx_stalled(seq: u8, seq_max: u8) {
+    BUS.lock(|b| {
+        let mut b = b.borrow_mut();
+        b.tx_stalled = b.tx_stalled.wrapping_add(1);
+        b.seq = seq;
+        b.seq_max = seq_max;
+    });
+}
+
+/// Take and reset the bus probe's counters.
+pub fn diag_bus_take() -> DiagBus {
+    BUS.lock(|b| b.replace(DiagBus::new()))
+}
+
+/// Configure the bus probe: on the SPI bus the runner samples the status and interrupt registers
+/// every `sample_ms` (0 = off), whether it was woken by an interrupt or by its own timer; with
+/// `drain`, a sample that finds a packet waiting reads it.
+pub fn diag_bus_config(sample_ms: u32, drain: bool) {
+    DRAIN.store(drain, core::sync::atomic::Ordering::Relaxed);
+    SAMPLE_MS.store(sample_ms, core::sync::atomic::Ordering::Relaxed);
+}
