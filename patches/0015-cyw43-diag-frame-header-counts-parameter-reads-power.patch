+++ b/cyw43/src/diag.rs
@@ -533,3 +533,40 @@ pub fn diag_console_take(out: &mut [u8]) -> (usize, u32) {
         (n, lost)
     })
 }
+
+/// The 4-byte BDC header of data-channel frames: how many carried each interface number (the low
+/// four bits of the third byte, counted up to 7), how many had a non-zero data offset, and the
+/// last header seen.
+#[derive(Clone, Copy, Default)]
+pub struct DiagRxMeta {
+    /// Frames by interface number (7 = seven or more).
+    pub by_interface: [u32; 8],
+    /// Frames whose header gave a non-zero data offset (extra signalling before the frame).
+    pub with_offset: u32,
+    /// The last header: flags, priority, flags2, data offset.
+    pub last: [u8; 4],
+}
+
+static RX_META: Mutex<CriticalSectionRawMutex, Cell<DiagRxMeta>> = Mutex::new(Cell::new(DiagRxMeta {
+    by_interface: [0; 8],
+    with_offset: 0,
+    last: [0; 4],
+}));
+
+pub(crate) fn rx_meta(header: [u8; 4]) {
+    RX_META.lock(|m| {
+        let mut v = m.get();
+        let i = ((header[2] & 0x0f) as usize).min(7);
+        v.by_interface[i] = v.by_interface[i].wrapping_add(1);
+        if header[3] != 0 {
+            v.with_offset = v.with_offset.wrapping_add(1);
+        }
+        v.last = header;
+        m.set(v);
+    })
+}
+
+/// Take and reset the frame-header counts.
+pub fn diag_rx_meta_take() -> DiagRxMeta {
+    RX_META.lock(|m| m.replace(DiagRxMeta::default()))
+}
