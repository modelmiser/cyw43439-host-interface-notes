--- a/cyw43/src/control.rs
+++ b/cyw43/src/control.rs
@@ -787,6 +787,23 @@ impl<'a> Control<'a> {
         )
     }
 
+    /// Diagnostic: read a named variable that takes a parameter (`name`, a zero byte, then `param`),
+    /// with the reply in `buf`. Returns the firmware's status and the reply length.
+    pub async fn diag_get_iovar_param(&mut self, name: &str, param: &[u8], buf: &mut [u8]) -> (i32, usize) {
+        if name.len() + 1 + param.len() > buf.len() {
+            return (crate::diag::DIAG_BAD_REQUEST, 0);
+        }
+        crate::diag::LAST_IOCTL_STATUS.store(crate::diag::DIAG_NO_REPLY, core::sync::atomic::Ordering::Relaxed);
+        buf.fill(0);
+        buf[..name.len()].copy_from_slice(name.as_bytes());
+        buf[name.len() + 1..][..param.len()].copy_from_slice(param);
+        let len = self.ioctl_inner(IoctlType::Get, Ioctl::GetVar, 0, buf).await;
+        (
+            crate::diag::LAST_IOCTL_STATUS.load(core::sync::atomic::Ordering::Relaxed),
+            len,
+        )
+    }
+
     /// Diagnostic: send the interface Up (command 2) or Down (command 3). Returns the firmware's status.
     pub async fn diag_updown(&mut self, up: bool) -> i32 {
         crate::diag::LAST_IOCTL_STATUS.store(crate::diag::DIAG_NO_REPLY, core::sync::atomic::Ordering::Relaxed);
@@ -818,6 +835,21 @@ impl<'a> Control<'a> {
         )
     }
 
+    /// Diagnostic: write (`Some`) or read (`None`) the power-save mode, commands 86 and 85.
+    /// Returns the firmware's status and, for a read, the value.
+    pub async fn diag_pm(&mut self, set: Option<u32>) -> (i32, u32) {
+        crate::diag::LAST_IOCTL_STATUS.store(crate::diag::DIAG_NO_REPLY, core::sync::atomic::Ordering::Relaxed);
+        let mut buf = set.unwrap_or(0).to_le_bytes();
+        match set {
+            Some(_) => self.ioctl(IoctlType::Set, Ioctl::SetPm, 0, &mut buf).await,
+            None => self.ioctl(IoctlType::Get, Ioctl::GetPm, 0, &mut buf).await,
+        };
+        (
+            crate::diag::LAST_IOCTL_STATUS.load(core::sync::atomic::Ordering::Relaxed),
+            u32::from_le_bytes(buf),
+        )
+    }
+
     /// Diagnostic: set "allmulti". Returns the firmware's status.
     pub async fn diag_set_allmulti(&mut self, on: bool) -> i32 {
         crate::diag::LAST_IOCTL_STATUS.store(crate::diag::DIAG_NO_REPLY, core::sync::atomic::Ordering::Relaxed);
