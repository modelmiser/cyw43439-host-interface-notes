diff --git a/examples/rp235x/src/bin/wifi_knob_sweep.rs b/examples/rp235x/src/bin/wifi_knob_sweep.rs
new file mode 100644
index 000000000..f1d979831
--- /dev/null
+++ b/examples/rp235x/src/bin/wifi_knob_sweep.rs
@@ -0,0 +1,324 @@
+//! Three probes of the monitor-mode stall, without Bluetooth, the radio restarted after each round:
+//!
+//! 1. the `dump` variable (Infineon's driver reads it with the sub-name "ulpstats"), with no
+//!    sub-name and with that one, before monitor mode and after a burst;
+//! 2. a knob sweep: one setting written before each monitor session (channel 11), then the burst,
+//!    the free-buffer figure and five small reads, to see whether any setting changes the 30-frame
+//!    burst, the figure's fall to 4, or the one-frame-per-host-packet rule;
+//! 3. in every round, the interface number in each delivered frame's 4-byte BDC header.
+//!
+//! Only settings that a restart undoes are written. A round whose numbers differ from the plain
+//! sequence (30 frames, figure 4, 5 frames for 5 commands) is marked `<<<`.
+
+#![no_std]
+#![no_main]
+
+use cyw43::aligned_bytes;
+use cyw43_pio::{PioSpi, RM2_CLOCK_DIVIDER};
+use defmt::*;
+use defmt_rtt as _;
+use embassy_executor::Spawner;
+use embassy_rp::gpio::{Level, Output};
+use embassy_rp::peripherals::{DMA_CH0, DMA_CH1, PIO0};
+use embassy_rp::pio::{InterruptHandler, Pio};
+use embassy_rp::{bind_interrupts, dma};
+use embassy_time::Timer;
+use panic_probe as _;
+use static_cell::StaticCell;
+
+bind_interrupts!(struct Irqs {
+    PIO0_IRQ_0 => InterruptHandler<PIO0>;
+    DMA_IRQ_0 => dma::InterruptHandler<DMA_CH0>, dma::InterruptHandler<DMA_CH1>;
+});
+
+#[embassy_executor::task]
+async fn cyw43_task(
+    runner: cyw43::Runner<'static, cyw43::SpiBus<Output<'static>, PioSpi<'static, PIO0, 0>>, cyw43::Cyw43439>,
+) -> ! {
+    runner.run().await
+}
+
+/// The "N" of the firmware's "Packet pool: N of M available" line, or -1.
+async fn pool(control: &mut cyw43::Control<'static>) -> i32 {
+    static mut BUF: [u8; 512] = [0; 512];
+    // SAFETY: single task, used sequentially.
+    #[allow(static_mut_refs)]
+    let buf = unsafe { &mut BUF };
+    let (status, len) = control.diag_get_iovar_buf("memuse", &mut buf[..]).await;
+    if status != 0 {
+        return -1;
+    }
+    let text = &buf[..len.min(512)];
+    let key = b"Packet pool: ";
+    let Some(at) = text.windows(key.len()).position(|w| w == key) else {
+        return -1;
+    };
+    let mut n = 0i32;
+    let mut any = false;
+    for c in &text[at + key.len()..] {
+        if c.is_ascii_digit() {
+            n = n * 10 + (*c - b'0') as i32;
+            any = true;
+        } else {
+            break;
+        }
+    }
+    if any { n } else { -1 }
+}
+
+/// Set up the Wi-Fi Direct listen state on `chanspec` with a 60 s dwell, and allmulti.
+async fn park(control: &mut cyw43::Control<'static>, chanspec: u16) -> bool {
+    let mut addr = control.address().await;
+    addr[0] |= 0x02;
+    let _ = control.diag_set_iovar("p2p_disc", &0u32.to_le_bytes()).await;
+    let _ = control.diag_set_iovar("p2p_da_override", &addr).await;
+    let s2 = control.diag_set_iovar("p2p_disc", &1u32.to_le_bytes()).await;
+    Timer::after_millis(500).await;
+    let mut res = [0u8; 16];
+    let (s3, _) = control.diag_get_iovar("p2p_dev", &mut res).await;
+    let idx = u32::from_le_bytes([res[0], res[1], res[2], res[3]]);
+    if s2 != 0 || s3 != 0 || idx > 15 {
+        warn!("listen setup failed: disc1 {} p2p_dev {} idx {}", s2, s3, idx);
+        return false;
+    }
+    let mut v = [0u8; 10];
+    v[..4].copy_from_slice(&idx.to_le_bytes());
+    let _ = control.diag_set_iovar("bsscfg:p2p_state", &v).await;
+    let _ = control.diag_set_allmulti(true).await;
+    v[4] = 1;
+    v[6..8].copy_from_slice(&chanspec.to_le_bytes());
+    v[8..10].copy_from_slice(&60000u16.to_le_bytes());
+    control.diag_set_iovar("bsscfg:p2p_state", &v).await == 0
+}
+
+/// Power-cycle the radio in place, load the firmware again and redo the Wi-Fi setup.
+async fn restart(
+    control: &mut cyw43::Control<'static>,
+    fw: &'static cyw43::Aligned<cyw43::A4, [u8]>,
+    nvram: &'static cyw43::Aligned<cyw43::A4, [u8]>,
+    clm: &[u8],
+) -> bool {
+    cyw43::diag_ignore_credit(false);
+    let _ = cyw43::diag_data_sent();
+    let (done, failed, _) = cyw43::diag_restart_result();
+    cyw43::diag_request_restart(fw, nvram);
+    for _ in 0..1000 {
+        Timer::after_millis(20).await;
+        let (d, f, ms) = cyw43::diag_restart_result();
+        if f != failed {
+            warn!("restart FAILED after {} ms", ms);
+            return false;
+        }
+        if d != done {
+            control.init(clm, cyw43::Config::default()).await;
+            return true;
+        }
+    }
+    warn!("restart did not finish");
+    false
+}
+
+/// Channel 11, 20 MHz, 2.4 GHz.
+const CH11: u16 = 0x100b;
+
+/// What to change before monitor mode.
+#[derive(Clone, Copy)]
+enum Knob {
+    /// The plain sequence.
+    None,
+    /// Leave allmulti off.
+    NoAllmulti,
+    /// Write a 32-bit value to a named variable.
+    Var(&'static str, u32),
+    /// Write bytes to a named variable.
+    Bytes(&'static str, &'static [u8]),
+    /// The power-save mode (command 86).
+    Pm(u32),
+    /// The promiscuous setting (command 10).
+    Promisc(u32),
+}
+
+const KNOBS: &[(&str, Knob)] = &[
+    ("control", Knob::None),
+    ("no allmulti", Knob::NoAllmulti),
+    ("bus:txglom 1", Knob::Var("bus:txglom", 1)),
+    ("bus:rxglom 1", Knob::Var("bus:rxglom", 1)),
+    ("bus:txglomalign 4", Knob::Var("bus:txglomalign", 4)),
+    ("ampdu_hostreorder 1", Knob::Var("ampdu_hostreorder", 1)),
+    ("ampdu_rx 0", Knob::Var("ampdu_rx", 0)),
+    ("ampdu_ba_wsize 1", Knob::Var("ampdu_ba_wsize", 1)),
+    ("ampdu_mpdu 1", Knob::Var("ampdu_mpdu", 1)),
+    ("ampdu_rx_factor 0", Knob::Var("ampdu_rx_factor", 0)),
+    ("tlv 1", Knob::Var("tlv", 1)),
+    ("tlv 7", Knob::Var("tlv", 7)),
+    ("pkt_filter_mode 0", Knob::Var("pkt_filter_mode", 0)),
+    ("arp_ol 1", Knob::Var("arp_ol", 1)),
+    ("arpoe 1", Knob::Var("arpoe", 1)),
+    ("control", Knob::None),
+    ("nmode 0", Knob::Var("nmode", 0)),
+    ("mimo_bw_cap 1", Knob::Var("mimo_bw_cap", 1)),
+    ("sgi_rx 0", Knob::Var("sgi_rx", 0)),
+    ("intol40 1", Knob::Var("intol40", 1)),
+    ("mfp 0", Knob::Var("mfp", 0)),
+    ("roam_off 1", Knob::Var("roam_off", 1)),
+    ("assoc_listen 1", Knob::Var("assoc_listen", 1)),
+    ("bcn_li_bcn 1", Knob::Var("bcn_li_bcn", 1)),
+    ("bcn_li_dtim 1", Knob::Var("bcn_li_dtim", 1)),
+    ("maxassoc 1", Knob::Var("maxassoc", 1)),
+    ("pm2_sleep_ret 10", Knob::Var("pm2_sleep_ret", 10)),
+    ("wd_disable 1", Knob::Var("wd_disable", 1)),
+    ("apsta 0", Knob::Var("apsta", 0)),
+    ("event_msgs none", Knob::Bytes("event_msgs", &[0; 24])),
+    ("power-save 0", Knob::Pm(0)),
+    ("power-save 2", Knob::Pm(2)),
+    ("promiscuous 1", Knob::Promisc(1)),
+    ("control", Knob::None),
+];
+
+/// Read `dump` with a sub-name and print what comes back.
+async fn dump(control: &mut cyw43::Control<'static>, when: &str, sub: &str) {
+    static mut BUF: [u8; 1024] = [0; 1024];
+    // SAFETY: single task, used sequentially.
+    #[allow(static_mut_refs)]
+    let buf = unsafe { &mut BUF };
+    let (status, len) = control.diag_get_iovar_param("dump", sub.as_bytes(), &mut buf[..]).await;
+    let end = len.min(1024);
+    let n = buf[..end].iter().position(|c| *c == 0).unwrap_or(end);
+    info!("1 dump \"{}\" {}: status {} len {} text bytes {}", sub, when, status, len, n);
+    for chunk in buf[..n.min(600)].chunks(120) {
+        info!("    {=[u8]:a}", chunk);
+    }
+}
+
+/// Print the firmware console text gathered since the last call.
+fn console(tag: &str) {
+    static mut TEXT: [u8; cyw43::DIAG_CONSOLE] = [0; cyw43::DIAG_CONSOLE];
+    // SAFETY: single task, used sequentially.
+    #[allow(static_mut_refs)]
+    let text = unsafe { &mut TEXT };
+    let (n, _) = cyw43::diag_console_take(&mut text[..]);
+    for raw in text[..n].split(|c| *c == b'\n') {
+        if !raw.is_empty() {
+            info!("    console {}: {=[u8]:a}", tag, raw[..raw.len().min(200)]);
+        }
+    }
+}
+
+#[embassy_executor::main(executor = "embassy_rp::executor::Executor", entry = "cortex_m_rt::entry")]
+async fn main(spawner: Spawner) {
+    let p = embassy_rp::init(Default::default());
+    let fw = aligned_bytes!("../../../../cyw43-firmware/43439A0.bin");
+    let clm = aligned_bytes!("../../../../cyw43-firmware/43439A0_clm.bin");
+    let nvram = aligned_bytes!("../../../../cyw43-firmware/nvram_rp2040.bin");
+
+    let pwr = Output::new(p.PIN_23, Level::Low);
+    let cs = Output::new(p.PIN_25, Level::High);
+    let mut pio = Pio::new(p.PIO0, Irqs);
+    let spi = PioSpi::new(
+        &mut pio.common,
+        pio.sm0,
+        RM2_CLOCK_DIVIDER,
+        pio.irq0,
+        cs,
+        p.PIN_24,
+        p.PIN_29,
+        dma::Channel::new(p.DMA_CH0, Irqs),
+        dma::Channel::new(p.DMA_CH1, Irqs),
+    );
+
+    static STATE: StaticCell<cyw43::State> = StaticCell::new();
+    let state = STATE.init(cyw43::State::new());
+    let (_net_device, mut control, runner) = cyw43::new(state, pwr, spi, fw, nvram).await;
+    spawner.spawn(unwrap!(cyw43_task(runner)));
+    control.init(clm, cyw43::Config::default()).await;
+
+    cyw43::diag_bus_config(20, false);
+    Timer::after_secs(2).await;
+    console("boot");
+
+    // 1. dump, before monitor and after a burst.
+    for sub in ["", "ulpstats"] {
+        dump(&mut control, "before monitor", sub).await;
+        console("dump");
+    }
+    if !park(&mut control, CH11).await {
+        return;
+    }
+    Timer::after_millis(300).await;
+    let _ = control.diag_monitor(Some(1)).await;
+    Timer::after_millis(1000).await;
+    for sub in ["", "ulpstats"] {
+        dump(&mut control, "after a burst", sub).await;
+        console("dump");
+    }
+    if !restart(&mut control, fw, nvram, clm).await {
+        return;
+    }
+    let _ = cyw43::diag_console_take(&mut [0u8; 16]);
+
+    // 2 and 3. The knob sweep.
+    for (name, knob) in KNOBS {
+        // The listen state first, with allmulti (park sets it); then the knob.
+        if !park(&mut control, CH11).await {
+            return;
+        }
+        let (mut set, mut readback) = (0i32, 0u32);
+        match *knob {
+            Knob::None => {}
+            Knob::NoAllmulti => {
+                set = control.diag_set_allmulti(false).await;
+            }
+            Knob::Var(var, value) => {
+                set = control.diag_set_iovar(var, &value.to_le_bytes()).await;
+                let mut res = [0u8; 4];
+                let _ = control.diag_get_iovar(var, &mut res).await;
+                readback = u32::from_le_bytes(res);
+            }
+            Knob::Bytes(var, value) => {
+                set = control.diag_set_iovar(var, value).await;
+            }
+            Knob::Pm(value) => {
+                set = control.diag_pm(Some(value)).await.0;
+                readback = control.diag_pm(None).await.1;
+            }
+            Knob::Promisc(value) => {
+                set = control.diag_promisc(Some(value)).await.0;
+                readback = control.diag_promisc(None).await.1;
+            }
+        }
+        let before = pool(&mut control).await;
+        Timer::after_millis(300).await;
+        let _ = cyw43::diag_rx_take();
+        let _ = cyw43::diag_rx_meta_take();
+        let (ms, _) = control.diag_monitor(Some(1)).await;
+        Timer::after_millis(1000).await;
+        let burst = cyw43::diag_rx_take();
+        let b0 = cyw43::diag_bus_take();
+        let after = pool(&mut control).await;
+        for _ in 0..4 {
+            let _ = control.diag_monitor(None).await;
+            Timer::after_millis(100).await;
+        }
+        Timer::after_millis(300).await;
+        let extra = cyw43::diag_rx_take();
+        let meta = cyw43::diag_rx_meta_take();
+        let odd = burst.frames != 30 || after != 4 || extra.frames != 5;
+        let n = (burst.frames as usize).min(6);
+        info!(
+            "2 knob {}: set status {} readback {} | monitor status {} | pool {} -> {} | burst {} | frames for 5 commands {} | seq/limit after the burst {}/{} | first bytes {=[u8]:02x} lengths {} | 3 frames by interface number {} with a data offset {} last header {=[u8]:02x} {}",
+            name, set, readback, ms, before, after, burst.frames, extra.frames, b0.seq, b0.seq_max,
+            burst.firsts[..n], burst.sizes[..n], meta.by_interface, meta.with_offset, meta.last,
+            if odd { "<<<" } else { "" }
+        );
+        console("knob");
+        if !restart(&mut control, fw, nvram, clm).await {
+            return;
+        }
+        // The start-up lines of the reloaded firmware are not wanted in the next round's console.
+        let _ = cyw43::diag_console_take(&mut [0u8; 16]);
+    }
+    info!("done");
+    loop {
+        Timer::after_secs(60).await;
+    }
+}
-- 
