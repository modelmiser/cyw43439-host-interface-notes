From 4274572467da3c8f5ff3d65e3f78d38bf370da7b Mon Sep 17 00:00:00 2001
From: Chad Aldreda <ca@modelmiser.com>
Date: Fri, 20 Nov 2026 21:33:03 -0800
Subject: [PATCH] cyw43 diag: diag_get_iovar_buf refuses a name that does not
 fit (DIAG_BAD_REQUEST); examples: drop unused helpers

Review findings on the public draft (panel round 4). Compiled and unit-tested; not re-run on the board.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 cyw43/src/control.rs                     |  6 ++++-
 cyw43/src/diag.rs                        |  3 +++
 cyw43/src/lib.rs                         |  4 +--
 examples/rp235x/src/bin/wifi_downup.rs   | 33 ------------------------
 examples/rp235x/src/bin/wifi_teardown.rs | 23 -----------------
 5 files changed, 10 insertions(+), 59 deletions(-)

diff --git a/cyw43/src/control.rs b/cyw43/src/control.rs
index 55f677fed..d3d355b06 100644
--- a/cyw43/src/control.rs
+++ b/cyw43/src/control.rs
@@ -771,8 +771,12 @@ impl<'a> Control<'a> {
 
     /// Diagnostic: read a named variable into a caller-sized buffer (for replies longer than 64
     /// bytes). `buf` must hold the name, a NUL, and the reply. Returns the firmware's status and
-    /// the reply length; the reply starts at `buf[0]`.
+    /// the reply length; the reply starts at `buf[0]`. If the name and its NUL do not fit in `buf`,
+    /// nothing is sent and the status is `DIAG_BAD_REQUEST`.
     pub async fn diag_get_iovar_buf(&mut self, name: &str, buf: &mut [u8]) -> (i32, usize) {
+        if name.len() >= buf.len() {
+            return (crate::diag::DIAG_BAD_REQUEST, 0);
+        }
         crate::diag::LAST_IOCTL_STATUS.store(crate::diag::DIAG_NO_REPLY, core::sync::atomic::Ordering::Relaxed);
         buf.fill(0);
         buf[..name.len()].copy_from_slice(name.as_bytes());
diff --git a/cyw43/src/diag.rs b/cyw43/src/diag.rs
index cb9fabbce..8e46e38a3 100644
--- a/cyw43/src/diag.rs
+++ b/cyw43/src/diag.rs
@@ -21,6 +21,9 @@ pub(crate) static LAST_IOCTL_STATUS: AtomicI32 = AtomicI32::new(0);
 /// Status value meaning "no reply to this command was recorded".
 pub const DIAG_NO_REPLY: i32 = i32::MIN;
 
+/// Status value meaning "the request did not fit the buffer; nothing was sent".
+pub const DIAG_BAD_REQUEST: i32 = i32::MIN + 1;
+
 /// What arrived on the data channel since the previous `diag_rx_take`.
 #[derive(Clone, Copy)]
 pub struct DiagRx {
diff --git a/cyw43/src/lib.rs b/cyw43/src/lib.rs
index df7deff29..6db223f55 100644
--- a/cyw43/src/lib.rs
+++ b/cyw43/src/lib.rs
@@ -36,8 +36,8 @@ use ioctl::IoctlState;
 
 pub use crate::control::{ApAuth, Config, Control, JoinAuth, JoinError, JoinOptions, ScanOptions, ScanType, Scanner};
 pub use crate::diag::{
-    DIAG_EV_SAMPLED, DIAG_EV_SAMPLES, DIAG_HEAD, DIAG_NO_REPLY, DIAG_SAMPLES, DiagBus, DiagEvents, DiagRx,
-    diag_bus_config, diag_bus_take, diag_events_take, diag_experiment, diag_keyhole, diag_rx_take,
+    DIAG_BAD_REQUEST, DIAG_EV_SAMPLED, DIAG_EV_SAMPLES, DIAG_HEAD, DIAG_NO_REPLY, DIAG_SAMPLES, DiagBus, DiagEvents,
+    DiagRx, diag_bus_config, diag_bus_take, diag_events_take, diag_experiment, diag_keyhole, diag_rx_take,
 };
 pub use crate::runner::Runner;
 pub use crate::sdio::SdioBus;
